{
  "name": "okamoshi",
  "version": "1.0.0",
  "private": true,
  "description": "岡山県統一模擬試験 公式サイト",
  "scripts": {
    "build": "python3 scripts/build.py",
    "build:ssg": "python3 scripts/build_ssg.py",
    "build:functions": "wrangler pages functions build",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm run build:functions",
    "dev": "wrangler pages dev . --compatibility-date=2025-01-01",
    "quality-gate": "node scripts/quality-gate/run.mjs",
    "quality-gate:smart": "node scripts/smart-quality-gate.mjs",
    "quality-gate:full": "node scripts/smart-quality-gate.mjs --full",
    "qg:static": "node scripts/quality-gate/static-checks.mjs",
    "qg:e2e": "playwright test -c playwright.config.mjs",
    "qg:forms": "playwright test -c playwright.config.mjs --grep @critical-forms",
    "prepare": "git config core.hooksPath .githooks && cp .githooks/pre-push .git/hooks/pre-push && chmod +x .githooks/pre-push .git/hooks/pre-push || true"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250214.0",
    "@playwright/test": "^1.64.1",
    "typescript": "^5.7.3",
    "wrangler": "^3.109.2"
  }
}
